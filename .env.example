# ==============================================================================
# MarketData Configuration & Optional API Keys
# ==============================================================================
# Note: Zero-key providers (Yahoo Finance, CCXT, Gate.io, MEXC, Coinbase) operate
# out-of-the-box without requiring any API keys.
#
# The keys below are strictly optional to enable secondary/fallback data sources.
# Rename or copy this file to `.env` to configure your keys.
# ==============================================================================

# Alpha Vantage (Free 25 requests/day for stocks, forex, crypto)
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Finnhub (Free 60 requests/min for stocks, forex, crypto candles)
# Get a free key at: https://finnhub.io/register
FINNHUB_API_KEY=

# Tiingo (Free 500 symbols/month, 30 req/min for clean IEX equities & crypto)
# Get a free key at: https://www.tiingo.com/
TIINGO_API_KEY=

# Polygon.io (Free 5 requests/min for Stocks, Forex, Crypto historical data)
# Get a free key at: https://polygon.io/
POLYGON_API_KEY=

# Twelve Data (Free 8 requests/min, 800/day for Forex, Commodities, Equities, Crypto)
# Get a free key at: https://twelvedata.com/
TWELVEDATA_API_KEY=
